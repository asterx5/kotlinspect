<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Captures the application context so no setup code is needed. Does nothing in release builds. -->
        <provider
            android:name="io.github.asterx5.kotlinspect.internal.KotlinspectInitProvider"
            android:authorities="${applicationId}.kotlinspect-init"
            android:exported="false" />

        <activity
            android:name="io.github.asterx5.kotlinspect.internal.KotlinspectActivity"
            android:exported="false"
            android:label="Kotlinspect"
            android:theme="@android:style/Theme.Material.NoActionBar" />
    </application>

</manifest>
